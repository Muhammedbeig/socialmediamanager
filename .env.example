# Copy to .env.local and fill in. Never commit real values or paste them into chat.
# Setup steps for each value are in docs/setup.md.

# PostgreSQL: app data and the pg-boss job queue (one job per Delivery).
# Replace YOUR_PASSWORD with the postgres password you chose at install.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/social_publisher
# Tests wipe this database on every run. Its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/social_publisher_test

# Where the app is reached in the browser, and where network logins send you back.
# Facebook allows http://localhost while the Meta app is in development mode. If Threads refuses an
# http address, switch to https://localhost:3000 (see docs/setup.md, step 5).
APP_URL=http://localhost:3000

# Set to 1 to show a "Fake network" in the Channels screen, for trying the app without real networks.
ENABLE_FAKE_CONNECTOR=

# Meta developer app (development mode). Facebook Pages and Instagram share the Facebook app ID
# and secret; Threads has its own.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Cloudflare R2: temporary public media URLs for Instagram and Threads.
R2_ACCOUNT_ID=
R2_BUCKET=social-publisher-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public URL, such as https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
