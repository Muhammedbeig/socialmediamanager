# Copy to .env.local and fill in. Never commit real values or paste them into chat.
# Setup steps for each value are in docs/setup.md.

# PostgreSQL: app data and the pg-boss job queue (one job per Delivery).
# Replace YOUR_PASSWORD with the postgres password you chose at install.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/social_publisher
# Tests wipe this database on every run. Its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/social_publisher_test

# Where the app is reached in the browser, and where network logins send you back.
# Threads only accepts https redirect addresses, so the app runs on https with a local certificate
# (docs/setup.md, step 5).
APP_URL=https://localhost:3000

# Set to 1 to show a "Fake network" in the Channels screen, for trying the app without real networks.
ENABLE_FAKE_CONNECTOR=

# Meta developer app (development mode). Facebook Pages and Instagram share the Facebook app ID
# and secret; Threads has its own.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional: Instagram app ID and secret, for connecting Instagram profiles directly (no Facebook
# Page). From the Meta app's Instagram use case, "API setup with Instagram login". They differ from
# the Facebook ones. The app cannot remove posts on profiles connected this way.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Set to 1 only if a Page you want is owned by a business portfolio and does not show up when
# connecting. Facebook then also asks you to share that portfolio.
FACEBOOK_BUSINESS_PAGES=

# LinkedIn app (Client ID and Client Secret from its Auth tab).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Leave empty to post as your personal profile. Set to 1 only for an app LinkedIn has granted the
# Community Management API, which posts to company Pages instead.
LINKEDIN_PAGES=

# Google Cloud OAuth client for YouTube (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok, Pinterest and X need no keys: each account logs in once in its own Chrome window.

# Cloudflare R2: temporary public media URLs for Instagram and Threads.
R2_ACCOUNT_ID=
R2_BUCKET=social-publisher-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public URL, such as https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
